---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Logo from '../components/Logo.astro';
import CityMap from '../components/CityMap.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import { service, breadcrumbs, faq } from '../lib/schema';
import { pathFor, pick, type Locale } from '../i18n';
import { link } from '../i18n/link';
import { uiFor } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = pick(link, locale);
const u = uiFor(locale);
const path = pathFor('link', locale);
---
<Base
  page="link"
  locale={locale}
  title={c.title}
  description={c.description}
  schema={[
    service({ name: 'linkMovix', path, description: c.description, serviceType: c.serviceType, locale }),
    breadcrumbs([{ name: c.crumb, path }], locale),
    faq(c.faq),
  ]}
>
  <Header current="link" locale={locale} />

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-logo"><Logo sub="link" size={24} /><span>{c.hero.eyebrow}</span></p>
          <h1>{c.hero.h1.a}<span class="grad">{c.hero.h1.b}</span></h1>
          <p class="lead">{c.hero.lead}</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#contact">{c.hero.cta}</a>
            <a class="btn btn-ghost" href="#how">{c.hero.how}</a>
          </div>
          <ul class="hero-chips" aria-label={c.hero.chipsAria}>
            {c.hero.chips.map((chip) => <li><span class="chip-dot chip-link"></span>{chip}</li>)}
          </ul>
        </div>
        <CityMap variant="link" t={u.map} />
      </div>
    </section>

    <section class="section" id="capacity">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.capacity.kicker}</p>
          <h2>{c.capacity.h2}</h2>
          <p class="sub">{c.capacity.sub}</p>
        </div>
        <div class="trio">
          {c.capacity.cards.map((card) => <div class="trio-card"><h3>{card.h}</h3><p>{card.p}</p></div>)}
        </div>
      </div>
    </section>

    <section class="section section-tint" id="how">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.how.kicker}</p>
          <h2>{c.how.h2}</h2>
        </div>
        <Steps steps={c.how.steps} tone="link" />
      </div>
    </section>

    <section class="section" id="who">
      <div class="wrap split">
        <div>
          <p class="kicker">{c.who.kicker}</p>
          <h2>{c.who.h2}</h2>
          <p class="sub">{c.who.sub}</p>
        </div>
        <div class="compare" aria-label={c.who.compareAria}>
          <div class="compare-col">
            <h3>{c.who.own.h}</h3>
            <ul>
              {c.who.own.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
          <div class="compare-col compare-us">
            <h3><Logo sub="link" size={26} /></h3>
            <ul>
              {c.who.us.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="wrap split">
        <div>
          <p class="kicker kicker-dark">{c.proof.kicker}</p>
          <h2>{c.proof.h2}</h2>
          <p class="sub">{c.proof.sub}</p>
        </div>
        <ul class="proof-list">
          {c.proof.items.map((i) => <li><strong>{i.b}</strong><span>{i.t}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.integration.kicker}</p>
          <h2>{c.integration.h2}</h2>
        </div>
        <div class="trio">
          {c.integration.cards.map((card) => <div class="trio-card"><h3>{card.h}</h3><p>{card.p}</p></div>)}
        </div>
      </div>
    </section>

    <Faq items={c.faq} locale={locale} />

    <Contact locale={locale} interest="link" title={c.contact.title} text={c.contact.text} />
  </main>
  <Footer current="link" locale={locale} />
</Base>
