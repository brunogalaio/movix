---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { breadcrumbs } from '../lib/schema';
import { pathFor, pick, type Locale } from '../i18n';
import { company } from '../i18n/company';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = pick(company, locale);
const path = pathFor('company', locale);

// Entries whose name starts with "[" are placeholders and render as dashed "to fill" cards.
const initials = (n: string) => (n.startsWith('[') ? '?' : n.split(' ').map((w) => w[0]).join('').slice(0, 2));
const states = ['done', 'now', 'next', 'next']; // milestone styling by position
---
<Base
  page="company"
  locale={locale}
  title={c.title}
  description={c.description}
  schema={[breadcrumbs([{ name: c.crumb, path }], locale)]}
>
  <Header current="company" locale={locale} cta="#investor-contact" />

  <main id="main">
    <section class="hero hero-company" id="top">
      <div class="wrap">
        <p class="eyebrow"><span class="pulse"></span>{c.hero.eyebrow}</p>
        <h1>{c.hero.h1.a}<span class="grad">{c.hero.h1.b}</span></h1>
        <p class="lead">{c.hero.lead}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#investor-contact">{c.hero.cta}</a>
          <a class="btn btn-ghost" href="#team">{c.hero.team}</a>
        </div>
      </div>
    </section>

    <section class="section" id="model">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.model.kicker}</p>
          <h2>{c.model.h2}</h2>
          <p class="sub">{c.model.sub}</p>
        </div>
        <div class="trio">
          <div class="trio-card"><Logo sub="link" size={30} /><h3>{c.model.cards[0].h}</h3><p>{c.model.cards[0].p}</p></div>
          <div class="trio-card"><Logo sub="fleet" size={30} /><h3>{c.model.cards[1].h}</h3><p>{c.model.cards[1].p}</p></div>
          <div class="trio-card"><Logo size={30} /><h3>{c.model.cards[2].h}</h3><p>{c.model.cards[2].p}</p></div>
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="wrap split">
        <div>
          <p class="kicker">{c.why.kicker}</p>
          <h2>{c.why.h2}</h2>
        </div>
        <ul class="why-list">
          {c.why.items.map((i) => <li><strong>{i.b}</strong> {i.t}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" id="traction">
      <div class="wrap split">
        <div>
          <p class="kicker">{c.where.kicker}</p>
          <h2>{c.where.h2}</h2>
          <p class="sub">{c.where.sub}</p>
        </div>
        <ol class="milestones">
          {c.where.milestones.map((m, i) => (
            <li class={`ms-${states[i]}`}><span class="ms-when">{m.when}</span><span>{m.what}</span></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-tint" id="team">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.team.kicker}</p>
          <h2>{c.team.h2}</h2>
        </div>
        <ul class="team">
          {c.team.people.map((t) => (
            <li class:list={['person', { placeholder: t.name.startsWith('[') }]}>
              <span class="avatar" aria-hidden="true">{initials(t.name)}</span>
              <div>
                <h3>{t.name}</h3>
                <p class="role">{t.role}</p>
                <p class="bio">{t.bio}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="backers">
      <div class="wrap split">
        <div>
          <p class="kicker">{c.backers.kicker}</p>
          <h2>{c.backers.h2}</h2>
          <p class="sub">{c.backers.sub}</p>
        </div>
        <div class="backers">
          <div class="backer placeholder">{c.backers.logo}</div>
          <div class="backer placeholder">{c.backers.logo}</div>
        </div>
      </div>
    </section>

    <section class="section" id="investor-contact">
      <div class="wrap">
        <div class="cta-card">
          <div class="cta-copy">
            <h2>{c.contact.h2}</h2>
            <p>{c.contact.text}</p>
          </div>
          <form class="cta-form" data-preview-form>
            <label>{c.contact.name}<input id="i-name" name="name" autocomplete="name" required /></label>
            <label>{c.contact.email}<input id="i-email" name="email" type="email" autocomplete="email" required /></label>
            <label>{c.contact.org}<input id="i-org" name="organisation" autocomplete="organization" /></label>
            <label>{c.contact.topic}
              <select id="i-topic" name="topic">
                {c.contact.topics.map((t) => <option>{t}</option>)}
              </select>
            </label>
            <button class="btn btn-dark" type="submit">{c.contact.submit}</button>
            <p class="form-note" role="status" hidden>{c.contact.note}</p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer current="company" locale={locale} />
  <script>
    document.querySelectorAll<HTMLFormElement>('[data-preview-form]').forEach((f) =>
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        f.querySelector<HTMLElement>('.form-note')!.hidden = false;
      }),
    );
  </script>
</Base>
