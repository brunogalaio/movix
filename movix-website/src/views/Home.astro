---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import Logo from '../components/Logo.astro';
import CityMap from '../components/CityMap.astro';
import { hrefFor, pick, type Locale } from '../i18n';
import { home } from '../i18n/home';
import { uiFor } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = pick(home, locale);
const u = uiFor(locale);
const dots = ['', 'tc-link', '', 'tc-ok']; // timeline dot per step
---
<Base page="home" locale={locale} title={c.title} description={c.description}>
  <Header current="home" locale={locale} />

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="eyebrow"><span class="pulse"></span>{c.eyebrow}</p>
          <h1>{c.h1.a}<span class="grad">{c.h1.b}</span></h1>
          <p class="lead">{c.lead}</p>
          <div class="hero-ctas">
            <a class="btn btn-primary" href="#contact">{c.cta}</a>
            <a class="btn btn-ghost" href="#products">{c.ctaMore}</a>
          </div>
          <ul class="hero-chips" aria-label={c.chipsAria}>
            <li><span class="chip-dot chip-link"></span>{c.chips[0]}</li>
            <li><span class="chip-dot chip-fleet"></span>{c.chips[1]}</li>
            <li><span class="chip-dot chip-parent"></span>{c.chips[2]}</li>
          </ul>
        </div>
        <CityMap t={u.map} />
      </div>
    </section>

    <section class="strip" aria-label={c.stripAria}>
      <div class="wrap strip-inner">
        {c.strip.map((s) => <div><strong>{s.b}</strong><span>{s.t}</span></div>)}
      </div>
    </section>

    <section class="section" id="products">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">{c.products.kicker}</p>
          <h2>{c.products.h2}</h2>
          <p class="sub">{c.products.sub}</p>
        </div>
        <div class="products">
          <a class="product product-link" href={hrefFor('link', locale)}>
            <Logo sub="link" size={40} />
            <h3>{c.products.link.h3}</h3>
            <p>{c.products.link.p}</p>
            <ul class="ticks">
              {c.products.link.ticks.map((t) => <li>{t}</li>)}
            </ul>
            <span class="btn btn-link">{c.products.link.cta} <span aria-hidden="true">→</span></span>
          </a>
          <a class="product product-fleet" href={hrefFor('fleet', locale)}>
            <Logo sub="fleet" size={40} />
            <h3>{c.products.fleet.h3}</h3>
            <p>{c.products.fleet.p}</p>
            <ul class="ticks">
              {c.products.fleet.ticks.map((t) => <li>{t}</li>)}
            </ul>
            <span class="btn btn-fleet">{c.products.fleet.cta} <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-dark" id="platform">
      <div class="wrap platform-grid">
        <div>
          <p class="kicker kicker-dark">{c.platform.kicker}</p>
          <h2>{c.platform.h2}</h2>
          <p class="sub">{c.platform.sub}</p>
          <ul class="ticks ticks-dark">
            {c.platform.ticks.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="timeline-card" aria-label={c.platform.cardAria}>
          <div class="tc-head">
            <span>{c.platform.parcel} <strong>MVX-2611-4821</strong></span>
            <span class="tc-badge">{c.platform.delivered}</span>
          </div>
          <ol class="tc-list">
            {c.platform.steps.map((s, i) => (
              <li class={i === c.platform.steps.length - 1 ? 'last' : undefined}>
                <span class={['tc-dot', dots[i]].filter(Boolean).join(' ')}>{dots[i] === 'tc-ok' ? '✓' : ''}</span>
                <div><strong>{s.b}</strong><span>{s.s}</span></div>
              </li>
            ))}
          </ol>
          <pre class="tc-code"><code>{`POST /webhooks/movix
{ "event": "parcel.delivered",
  "proof": { "pin": "verified", "photo": true } }`}</code></pre>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap expand">
        <div>
          <p class="kicker">{c.expand.kicker}</p>
          <h2>{c.expand.h2}</h2>
          <p class="sub">{c.expand.sub}</p>
        </div>
        <ul class="cities">
          {c.expand.cities.map((city, i) => (
            <li class={i === 0 ? 'live' : undefined}><span></span>{city.n} <em>{city.tag}</em></li>
          ))}
        </ul>
      </div>
    </section>

    <Contact locale={locale} />
  </main>
  <Footer current="home" locale={locale} />
</Base>
