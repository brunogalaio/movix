---
/**
 * fleetMovix hero diagram: your line-haul (full loads, part loads, parcels) converges on our cross-dock,
 * and our own fleet fans out into the city. Left to right is the flow.
 * Text is real HTML and the illustrations are inline SVG, so it stays sharp and re-flows on phones.
 */
import type { FleetCopy } from '../i18n/fleet';
interface Props { t: FleetCopy['handoff'] }
const { t } = Astro.props;
// Icons are language independent; the labels come from the page copy.
const inbound = t.inbound.map((label, i) => ({ label, icon: ['cube', 'pallet', 'parcel'][i] }));
const dests = t.dests.map((d, i) => ({ ...d, icon: ['fork', 'shop', 'home'][i], focus: i === 0 }));
const icons: Record<string, string> = {
  cube: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12L4 7.5M12 12v9',
  pallet: 'M3 18h18v3H3zM4.5 18v-6h7v6M13 18V9h7v9',
  parcel: 'M4 8l2-4h12l2 4M4 8h16v12H4zM10 8v4h4V8',
  fork: 'M6 3v6a2.5 2.5 0 0 0 5 0V3M8.5 3v18M17 21V3c-2.5 1.5-3 5-3 8h3',
  shop: 'M4 9l1.5-5h13L20 9a2.7 2.7 0 0 1-5.3 0 2.7 2.7 0 0 1-5.4 0A2.7 2.7 0 0 1 4 9zM5 11.5V20h14v-8.5M10 20v-5h4v5',
  home: 'M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-5h4v5',
};
const mPath = 'M14 44 V28 a8 8 0 0 1 16 0 V44 M30 28 a8 8 0 0 1 16 0 V35';
const arrow = 'M5 12h14M13 6l6 6-6 6';
---
<div class="ho" role="group" aria-label={t.aria}>

  <div class="ho-zone ho-yours">
    <p class="ho-tag">{t.yours}</p>
    <div class="ho-yours-body">
      <ul class="ho-inbound" aria-label={t.inboundAria}>
        {inbound.map((d) => (
          <li>
            <span class="ho-tile"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={icons[d.icon]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="ho-dtext"><strong>{d.label}</strong></span>
          </li>
        ))}
      </ul>
    </div>
    <p class="ho-foot">{t.foot} <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></p>
  </div>

  <span class="ho-handoff-m" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </span>

  <div class="ho-zone ho-ours">
    <p class="ho-tag">{t.ours}</p>
    <div class="ho-ours-body">
      <span class="ho-handoff" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d={arrow} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>

      <div class="ho-converge" aria-hidden="true">
        <svg viewBox="0 0 90 300" preserveAspectRatio="none">
          <g fill="none" stroke-linecap="round">
            <path class="ho-line" d="M0 46 C45 46 45 150 90 150" />
            <path class="ho-line" d="M0 150 H90" />
            <path class="ho-line" d="M0 254 C45 254 45 150 90 150" />
            <path class="ho-dots" d="M0 46 C45 46 45 150 90 150" />
            <path class="ho-dots" d="M0 150 H90" />
            <path class="ho-dots" d="M0 254 C45 254 45 150 90 150" />
          </g>
        </svg>
      </div>

      <div class="ho-card ho-dock">
        <svg class="ho-art" viewBox="0 20 320 140" aria-hidden="true">
          <defs><radialGradient id="ho-glow" cx="0.36" cy="0.55" r="0.6"><stop offset="0" stop-color="#FFB800" stop-opacity="0.22" /><stop offset="1" stop-color="#FFB800" stop-opacity="0" /></radialGradient></defs>
          <rect x="0" y="20" width="320" height="140" fill="url(#ho-glow)" />
          <rect x="0" y="147" width="320" height="6" rx="3" class="ho-dground" />
          <rect x="14" y="40" width="206" height="108" rx="10" class="ho-building" />
          <rect x="8" y="32" width="218" height="16" rx="8" class="ho-roof" />
          <circle cx="117" cy="78" r="17" class="ho-sign" />
          <g transform="translate(100 61) scale(0.53)"><path d={mPath} fill="none" stroke="#1B1A1F" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /><circle cx="46" cy="46" r="5.4" fill="#1B1A1F" /></g>
          {[31, 94, 157].map((x, i) => (
            <g>
              <rect x={x} y="104" width="46" height="44" rx="4" class={i === 1 ? 'ho-door-open' : 'ho-door'} />
              {i === 1
                ? <g><rect x={x} y="104" width="46" height="12" rx="4" class="ho-door" /><path d={`M${x + 4} 110 H${x + 42}`} class="ho-slat" /><rect x={x + 7} y="124" width="17" height="24" rx="2" class="ho-box" /><rect x={x + 26} y="134" width="13" height="14" rx="2" class="ho-box2" /></g>
                : <path d={`M${x + 4} 114 H${x + 42} M${x + 4} 124 H${x + 42} M${x + 4} 134 H${x + 42}`} class="ho-slat" />}
            </g>
          ))}
          <path d="M221 124 h8 M218 131 h11 M221 138 h8" class="ho-speed" />
          <rect x="234" y="112" width="42" height="36" rx="7" class="ho-van" />
          <path d="M276 148 V122 h10 a8 8 0 0 1 6.6 3.5 l8.5 12.5 a8 8 0 0 1 1.4 4.5 V148 Z" class="ho-van" />
          <path d="M280 126.5 h8.5 l9 12.5 H280 z" class="ho-vglass" />
          <rect x="240" y="122" width="28" height="6" rx="3" class="ho-vstripe" />
          <rect x="240" y="132" width="17" height="5" rx="2.5" class="ho-vstripe2" />
          {[250, 291].map((cx) => (
            <g><circle cx={cx} cy="145" r="8" class="ho-wheel" /><circle cx={cx} cy="145" r="3" class="ho-hub" /></g>
          ))}
        </svg>
        <div>
          <strong class="ho-title"><span class="ho-fl">fleet</span>Movix cross-dock</strong>
          <span class="ho-sub">{t.dockSub}</span>
        </div>
        <ul class="ho-steps" aria-label={t.stepsAria}>
          {t.steps.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div class="ho-branch" aria-hidden="true">
        <svg viewBox="0 0 56 300" preserveAspectRatio="none">
          <g fill="none" stroke-linecap="round">
            <path class="ho-line" d="M0 150 C28 150 28 46 56 46" />
            <path class="ho-line" d="M0 150 H56" />
            <path class="ho-line" d="M0 150 C28 150 28 254 56 254" />
            <path class="ho-dots" d="M0 150 C28 150 28 46 56 46" />
            <path class="ho-dots" d="M0 150 H56" />
            <path class="ho-dots" d="M0 150 C28 150 28 254 56 254" />
          </g>
        </svg>
      </div>
      <div class="ho-branch-m" aria-hidden="true"></div>

      <ul class="ho-dests">
        {dests.map((d) => (
          <li class:list={[{ 'is-focus': d.focus }]}>
            <span class="ho-tile"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d={icons[d.icon]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <span class="ho-dtext"><strong>{d.label}</strong><span>{d.sub}</span></span>
            {d.focus && <span class="ho-focus">{t.focus}</span>}
          </li>
        ))}
      </ul>
    </div>

    <div class="ho-time">
      <span class="ho-time-end">{t.drop}</span>
      <span class="ho-time-line"><span class="ho-pill"><b>{t.pill.b}</b> {t.pill.t}</span></span>
      <span class="ho-time-end ho-time-done">{t.done}</span>
    </div>
  </div>
</div>
