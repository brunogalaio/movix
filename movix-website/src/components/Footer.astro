---
import Logo from './Logo.astro';
import { site } from '../config/site';
import { alternates, hrefFor, isPageId, localeMeta, pathFor, type Locale } from '../i18n';
import { isLive } from '../lib/pages';
import { uiFor } from '../i18n/ui';
interface Props { current?: 'home' | 'link' | 'fleet' | 'company' | 'blog'; locale?: Locale }
const { current = 'blog', locale = 'en' } = Astro.props;
const u = uiFor(locale);
const alts = isPageId(current) ? alternates(current) : [];
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a href={pathFor('home', locale)} class="brand" aria-label={u.brandHome}><Logo size={30} /></a>
      <p>{u.footer.tagline}. {u.footer.place}.</p>
    </div>
    <nav class="footer-nav" aria-label={u.footer.aria}>
      <a href={hrefFor('link', locale)} class="brand"><Logo sub="link" size={26} /></a>
      <a href={hrefFor('fleet', locale)} class="brand"><Logo sub="fleet" size={26} /></a>
      {isLive('company') && <a href={hrefFor('company', locale)}>{u.footer.company}</a>}
      {site.blogPublic && <a href="/blog/">{u.footer.cases}</a>}
    </nav>
    {alts.length > 1 && (
      <p class="footer-langs">
        <span>{u.footer.languages}:</span>
        {alts.map((a) => (
          <a href={a.href} lang={localeMeta[a.locale].htmlLang} hreflang={localeMeta[a.locale].hreflang} aria-current={a.locale === locale ? 'true' : undefined}>{localeMeta[a.locale].name}</a>
        ))}
      </p>
    )}
    <p class="footer-legal">© 2026 {site.legalName ?? site.name}. {u.footer.legal}</p>
  </div>
</footer>
