---
/**
 * Pop Route logo mark for the parent brand and both sub-brands (from brand-kit/option-b-pop-route).
 */
interface Props { sub?: 'movix' | 'fleet' | 'link'; size?: number; class?: string }
const { sub = 'movix', size = 40, class: cls = '' } = Astro.props;
const m = 'M14 44 V28 a8 8 0 0 1 16 0 V44 M30 28 a8 8 0 0 1 16 0 V35';
const pop = { movix: ['#FF3D6E', '#FFFFFF'], fleet: ['#FFB800', '#1B1A1F'], link: ['#14D29A', '#1B1A1F'] }[sub];
---
<span class={`mark ${cls}`} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 64 64" width={size} height={size}>
    <circle cx="32" cy="32" r="32" fill={pop[0]} />
    <path d={m} fill="none" stroke={pop[1]} stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
    {sub === 'link'
      ? <circle cx="46" cy="46" r="4.6" fill="none" stroke={pop[1]} stroke-width="3.4" />
      : <circle cx="46" cy="46" r="5.4" fill={pop[1]} />}
  </svg>

</span>
