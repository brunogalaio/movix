---
interface Props { steps: { t: string; d: string }[]; tone: 'link' | 'fleet' }
const { steps, tone } = Astro.props;
---
<ol class={`steps steps-${tone}`}>
  {steps.map((s, i) => (
    <li class="step">
      <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
      <h3>{s.t}</h3>
      <p>{s.d}</p>
    </li>
  ))}
</ol>
