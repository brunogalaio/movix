---
/** Language dropdown for the header. Only shows the languages the current page exists in; hidden when there is just one. */
import { localeMeta, type Locale } from '../i18n';
import { uiFor } from '../i18n/ui';
interface Props { locale: Locale; alts: { locale: Locale; href: string }[] }
const { locale, alts } = Astro.props;
const u = uiFor(locale);
---
{alts.length > 1 && (
  <details class="lang" data-lang-menu>
    <summary aria-label={`${u.lang.label}: ${localeMeta[locale].name}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3.5 9h17M3.5 15h17M12 3c2.5 2.5 3.8 5.6 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.6-3.8-9S9.5 5.5 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span>{localeMeta[locale].short}</span>
      <svg class="lang-caret" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </summary>
    <ul class="lang-menu">
      {alts.map((a) => (
        <li>
          <a href={a.href} lang={localeMeta[a.locale].htmlLang} hreflang={localeMeta[a.locale].hreflang} aria-current={a.locale === locale ? 'true' : undefined} data-lang-pick>
            {localeMeta[a.locale].name}<span aria-hidden="true">{localeMeta[a.locale].short}</span>
          </a>
        </li>
      ))}
    </ul>
  </details>
)}
<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]');
  const closeAll = (except?: Element | null) => menus.forEach((m) => { if (m !== except) m.open = false; });
  document.addEventListener('click', (e) => closeAll((e.target as Element).closest('[data-lang-menu]')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  // An explicit choice means the visitor does not need the suggestion banner again.
  document.querySelectorAll('[data-lang-pick]').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('movix-lang-banner', 'off'); } catch { /* storage may be blocked */ } }),
  );
</script>
